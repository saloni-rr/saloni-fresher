<?xml version="1.0" encoding="UTF-8"?>


<odoo>
    <record id="student_department_list_view" model="ir.ui.view">
               <field name="name">student.department.list</field>
                <field name="model">student.department</field>
                <field name="type">list</field>
                <field name="arch" type="xml">
                        <list>
                                <field name="name"/>
                                <field name="student_id"/>
                                 <field name="student_ids"/>
                        </list>
                </field>
        </record>
        <record id="student_department_form_view" model="ir.ui.view">
               <field name="name">student.department.form</field>
                <field name="model">student.department</field>
                <field name="type">form</field>
                <field name="arch" type="xml">
                        <form string="Department">
                          <sheet>
                               <group>
                                    <field name="name"/>
                                   <field name="student_id"/>
                                   <field name="student_ids"/>
                               </group>
                          </sheet>
                        </form>
                </field>
        </record>
             <record id="department_action" model="ir.actions.act_window">
                 <field name="name">Students</field>
                 <field name="res_model">student.department</field>
                  <field name="view_mode">list,form</field>
         </record>

             <menuitem id="department_main_menu"
                   name="Student Department"/>
             <menuitem id="department_sub_menu"
                  name="Student Department"
                  parent="department_main_menu"
                  action="department_action"
                   />


</odoo>