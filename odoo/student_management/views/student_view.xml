<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <!-- List View -->
        <record id="student_list_view" model="ir.ui.view">
                <field name="name">student.management.list</field>
                <field name="model">student.management</field>
                <field name="arch" type="xml">
                        <list>
                            <field name="image" widget="image"/>
                                <field name="name"/>
                                <field name="age"/>
                                <field name="phone"/>
                                <field name="email"/>
                               <field name="dob" />
                                <field name="percentage"/>
                                <field name="description"/>
                                <field name="dob"/>
                                <field name="admission"/>
                                <field name="photo"/>
                                <field name="notes"/>
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="fees" widget="monetary"/>
                               <field name="is_active" widget="boolean_toggle"/>
                        </list>
                </field>
        </record>

            <!-- Form View -->
            <record id="student_form_view" model="ir.ui.view">
                    <field name="name">student.management.form</field>
                     <field name="model">student.management</field>
                    <field name="arch" type="xml">
                            <form>
                                    <sheet>
                                            <group>
                                                   <group>
                                                       <field name="image" widget="image"/>
                                                    <field name="name"/>
                                                    <field name="age"/>
                                                    <field name="phone"/>
                                                       <field name="email" widget="email"/>
                                                    <field name="percentage"/>
                                                       <field name="is_active" widget="boolean_toggle"/>
                                                       <field name="gender" widget="radio"/>
                                                       <field name="gender" widget="badge"/>
                                                     <field name="fees" widget="monetary"/>
                                                   </group>
                                                 <group>
                                                    <field name="description"/>
                                                    <field name="dob"/>
                                                    <field name="admission"/>
                                                    <field name="photo"/>
                                                    <field name="notes"/>
                                                    <field name="user_id"/>
                                                    <field name="email"/>
                                                     <field name="department_ids" widget="many2many_tags"/>
                                                     <field name="department_id" widget="many2one"/>
                                            </group>
                                            </group>
                                    </sheet>
                            </form>
                    </field>
            </record>
         <record id="student_action" model="ir.actions.act_window">
                 <field name="name">Students</field>
                 <field name="res_model">student.management</field>
                  <field name="view_mode">list,form</field>
         </record>
            <!-- Menu -->
         <menuitem id="student_main_menu"
                   name="Student Management"/>
        <menuitem id="student_sub_menu"
                  name="Student Management"
                  parent="student_main_menu"
                  action="student_action"
                   />
</odoo>